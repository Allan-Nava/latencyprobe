# The image goreleaser publishes. It builds nothing: goreleaser has already
# cross-compiled the binary and stages it under <os>/<arch>/ in the build
# context, one platform at a time, so TARGETPLATFORM selects it.
#
# distroless/static:nonroot rather than scratch: there is no build stage here to
# copy a CA bundle from, and this base keeps one maintained. It has no shell
# and runs as 65532, the same contract as the Dockerfile.
FROM gcr.io/distroless/static:nonroot
ARG TARGETPLATFORM
COPY ${TARGETPLATFORM}/latencyprobe /latencyprobe
ENTRYPOINT ["/latencyprobe"]
CMD ["--help"]
